<template>
  <div class="user-profile">
    <h2>{{ user.name }}</h2>
    <p>{{ user.name + ' - ' + user.email }}</p>
    <button @click="updateUser">更新用户</button>
  </div>
</template>

<script>
export default {
  props: ['userId'],
  data() {
    return {
      user: null,
      loading: false
    }
