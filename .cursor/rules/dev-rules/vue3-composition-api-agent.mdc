  methods: {
    async updateUser() {
      this.loading = true
      try {
        this.user = await userService.update(this.user)
        this.$emit('userUpdated', this.user)
      } finally {
        this.loading = false
      }
    }
  },
  async mounted() {
    this.user = await userService.getById(this.userId)
  }
}PP
</script>
```
</example>
