# 开发模式和最佳实践

## Vue 3.4 Composition API 模式

### 标准组件模板
```typescript
<template>
  <div class="component-container">
    <!-- 组件内容 -->
  </div>
</template>

<script setup lang="ts">
import { ref, computed, watch, onMounted } from 'vue'

// Props 定义
interface Props {
  title: string
  items?: any[]
}

// Emits 定义
interface Emits {
  (e: 'update', value: any): void
  (e: 'delete', id: string): void
}

const props = defineProps<Props>()
const emit = defineEmits<Emits>()

// 响应式数据
const isVisible = ref(false)
const selectedId = ref<string | null>(null)

// 计算属性
const filteredItems = computed(() => {
  return props.items?.filter(item => item.active) || []
})

// 侦听器
watch(selectedId, (newId) => {
  if (newId) {
    emit('update', newId)
  }
})

// 生命周期
onMounted(() => {
  // 初始化逻辑
})
</script>
```

### Composables 模式
参考 [src/utils/helpers.ts](mdc:src/utils/helpers.ts) 创建可复用的组合式函数：

```typescript
// useBookmarks.ts
import { ref, computed } from 'vue'
import { bookmarkService } from '@/services/bookmarkService'

export function useBookmarks() {
  const bookmarks = ref([])
  const loading = ref(false)
  const error = ref<string | null>(null)

  const loadBookmarks = async () => {
    loading.value = true
    try {
      bookmarks.value = await bookmarkService.getAll()
    } catch (err) {
      error.value = err.message
    } finally {
      loading.value = false
    }
  }

  return {
    bookmarks,
    loading,
    error,
    loadBookmarks
  }
}
```

## TypeScript 类型定义模式

### 接口继承
```typescript
interface BaseItem {
  id: string
  createdAt: Date
  updatedAt: Date
}

interface BookmarkItem extends BaseItem {
  title: string
  url: string
  favicon?: string
  folderId?: string
}

interface FolderItem extends BaseItem {
  name: string
  parentId?: string
  children?: (BookmarkItem | FolderItem)[]
}
```

### 工具类型使用
```typescript
// 从现有类型创建新类型
type BookmarkCreate = Omit<BookmarkItem, 'id' | 'createdAt' | 'updatedAt'>
type BookmarkUpdate = Partial<BookmarkCreate>

// 联合类型
type TreeNode = BookmarkItem | FolderItem

// 泛型约束
interface ApiResponse<T> {
  data: T
  message: string
  success: boolean
}
```

## Chrome 扩展开发模式

### 后台脚本通信
参考 [src/background.ts](mdc:src/background.ts) 进行消息处理：

```typescript
// 发送消息
const sendMessage = async (action: string, data?: any) => {
  return new Promise((resolve) => {
    chrome.runtime.sendMessage({ action, data }, resolve)
  })
}

// 接收消息
chrome.runtime.onMessage.addListener((request, sender, sendResponse) => {
  switch (request.action) {
    case 'getBookmarks':
      handleGetBookmarks().then(sendResponse)
      return true // 异步响应
    default:
      sendResponse({ error: 'Unknown action' })
  }
})
```

### 存储服务模式
参考 [src/services/storageService.ts](mdc:src/services/storageService.ts)：

```typescript
class StorageService {
  async get<T>(key: string): Promise<T | null> {
    const result = await chrome.storage.sync.get(key)
    return result[key] || null
  }

  async set<T>(key: string, value: T): Promise<void> {
    await chrome.storage.sync.set({ [key]: value })
  }

  async remove(key: string): Promise<void> {
    await chrome.storage.sync.remove(key)
  }
}
```

