## 错误处理模式

### 全局错误处理
```typescript
// 错误处理工具
export class AppError extends Error {
  constructor(
    message: string,
    public code?: string,
    public statusCode?: number
  ) {
    super(message)
    this.name = 'AppError'
  }
}

// 错误边界组件
export function useErrorHandler() {
  const error = ref<AppError | null>(null)

  const handleError = (err: unknown) => {
    console.error('Application error:', err)

    if (err instanceof AppError) {
      error.value = err
    } else {
      error.value = new AppError('未知错误')
    }
  }

  const clearError = () => {
    error.value = null
  }

  return {
    error: readonly(error),
    handleError,
    clearError
  }
}
```

### 异步操作错误处理
```typescript
const useAsyncOperation = () => {
  const loading = ref(false)
  const error = ref<string | null>(null)

  const execute = async <T>(operation: () => Promise<T>): Promise<T | null> => {
    loading.value = true
    error.value = null

    try {
      const result = await operation()
      return result
    } catch (err) {
      error.value = err instanceof Error ? err.message : '操作失败'
      return null
    } finally {
      loading.value = false
    }
  }

  return {
    loading: readonly(loading),
    error: readonly(error),
    execute
  }
}
```

## 测试模式

### 组件测试
```typescript
// 组件测试示例
import { mount } from '@vue/test-utils'
import { describe, it, expect } from 'vitest'
import BookmarkCard from '@/components/BookmarkCard.vue'

describe('BookmarkCard', () => {
  it('renders bookmark information correctly', () => {
    const bookmark = {
      id: '1',
      title: 'Test Bookmark',
      url: 'https://example.com',
      favicon: 'https://example.com/favicon.ico'
    }

    const wrapper = mount(BookmarkCard, {
      props: { bookmark }
    })

    expect(wrapper.find('h3').text()).toBe('Test Bookmark')
    expect(wrapper.find('img').attributes('src')).toBe(bookmark.favicon)
  })
})
```

### 服务测试
```typescript
// 服务测试示例
import { describe, it, expect, vi } from 'vitest'
import { bookmarkService } from '@/services/bookmarkService'

describe('BookmarkService', () => {
  it('should fetch bookmarks successfully', async () => {
    const mockBookmarks = [
      { id: '1', title: 'Test', url: 'https://test.com' }
    ]

    vi.spyOn(chrome.bookmarks, 'getTree').mockResolvedValue(mockBookmarks)

    const bookmarks = await bookmarkService.getAll()
    expect(bookmarks).toEqual(mockBookmarks)
  })
})
```
